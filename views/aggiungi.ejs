<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090b10">
  <title><%= titoloPagina %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="page">
    <nav class="site-nav" aria-label="Navigazione principale">
      <a class="brand" href="/" aria-label="Cineteca, home"><span class="brand-mark">C</span> Cineteca</a>
      <div class="site-nav-links">
        <a href="/catalogo">Il catalogo</a>
        <a class="nav-cta active" href="/aggiungi">Aggiungi un film <span aria-hidden="true">↗</span></a>
      </div>
    </nav>

    <header class="page-header">
      <p class="eyebrow"><span></span> Allarga la collezione</p>
      <h1>Ogni grande storia<br>merita un <em>posto.</em></h1>
      <p>Aggiungi i dettagli del film e fallo entrare nella cineteca.</p>
    </header>

    <form class="form-film" action="/aggiungi" method="post">
      <div class="campo-form">
        <label for="titolo">Titolo</label>
        <input type="text" id="titolo" name="titolo" required>
      </div>

      <div class="campo-form">
        <label for="regista">Regista</label>
        <input type="text" id="regista" name="regista" required>
      </div>

      <div class="campo-form">
        <label for="anno">Anno</label>
        <input type="number" id="anno" name="anno" min="1888" step="1" required>
      </div>

      <div class="campo-form">
        <label for="genere">Genere</label>
        <input type="text" id="genere" name="genere" required>
      </div>

      <div class="campo-form">
        <label for="trama">Trama</label>
        <textarea id="trama" name="trama" rows="5" required></textarea>
      </div>

      <button class="button button-primary" type="submit">Aggiungi film <span aria-hidden="true">→</span></button>
    </form>
  </main>
</body>
</html>
