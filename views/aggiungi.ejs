<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= titoloPagina %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="page">
    <nav class="navigazione" aria-label="Navigazione principale">
      <a href="/">Home</a>
      <a href="/catalogo">Catalogo</a>
    </nav>

    <header class="page-header">
      <h1>Aggiungi un film</h1>
      <p>Inserisci i dettagli del film da aggiungere al catalogo.</p>
    </header>

    <form class="form-film" action="/aggiungi" method="post">
      <div class="campo-form">
        <label for="titolo">Titolo</label>
        <input type="text" id="titolo" name="titolo" required>
      </div>

      <div class="campo-form">
        <label for="regista">Regista</label>
        <input type="text" id="regista" name="regista" required>
      </div>

      <div class="campo-form">
        <label for="anno">Anno</label>
        <input type="number" id="anno" name="anno" min="1888" step="1" required>
      </div>

      <div class="campo-form">
        <label for="genere">Genere</label>
        <input type="text" id="genere" name="genere" required>
      </div>

      <div class="campo-form">
        <label for="trama">Trama</label>
        <textarea id="trama" name="trama" rows="5" required></textarea>
      </div>

      <button type="submit">Aggiungi film</button>
    </form>
  </main>
</body>
</html>
