<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090b10">
  <title><%= titoloPagina %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="page">
    <nav class="site-nav" aria-label="Navigazione principale">
      <a class="brand" href="/" aria-label="Cineteca, home"><span class="brand-mark">C</span> Cineteca</a>
      <div class="site-nav-links">
        <a class="active" href="/catalogo">Il catalogo</a>
        <a class="nav-cta" href="/aggiungi">Aggiungi un film <span aria-hidden="true">↗</span></a>
      </div>
    </nav>

    <header class="page-header">
      <p class="eyebrow"><span></span> La collezione</p>
      <h1>Storie da <em>riscoprire.</em></h1>
      <% if (titoloRicerca) { %>
        <p><%= film.length %> <%= film.length === 1 ? 'risultato' : 'risultati' %> per “<%= titoloRicerca %>”.</p>
      <% } else { %>
        <p>Una selezione di <%= film.length %> <%= film.length === 1 ? 'film' : 'film' %> da vivere, ricordare e condividere.</p>
      <% } %>
    </header>

    <form class="ricerca" action="/catalogo" method="get">
      <div>
        <label class="sr-only" for="titolo">Cerca un film per titolo</label>
        <span class="search-icon" aria-hidden="true">⌕</span>
        <input type="search" id="titolo" name="titolo" placeholder="Cerca un film..." value="<%= titoloRicerca %>">
        <button class="button button-primary" type="submit">Cerca <span aria-hidden="true">→</span></button>
      </div>
      <% if (titoloRicerca) { %>
        <a class="reset-search" href="/catalogo">Mostra tutta la collezione <span aria-hidden="true">↗</span></a>
      <% } %>
    </form>

    <div class="collection-heading">
      <h2><%= titoloRicerca ? 'Risultati della ricerca' : 'In evidenza' %></h2>
      <span><%= film.length %> titoli</span>
    </div>

    <% if (film.length === 0) { %>
      <% if (titoloRicerca) { %>
        <p class="nessun-risultato">Nessun film trovato per “<%= titoloRicerca %>”. Prova con un altro titolo.</p>
      <% } else { %>
        <p class="nessun-risultato">La collezione è vuota per ora. Aggiungi il primo film.</p>
      <% } %>
    <% } else { %>
      <section class="catalogo" aria-label="Elenco dei film">
        <% film.forEach(opera => { %>
          <article class="film-card">
            <a class="film-poster film-poster-<%= (Number(opera.id) - 1) % 6 %>" href="/film/<%= opera.id %>" aria-label="Apri i dettagli di <%= opera.titolo %>">
              <span class="poster-number"><%= String(opera.anno || 'FILM').slice(0, 4) %></span>
              <span class="poster-copy">
                <span class="poster-genre"><%= opera.genere %></span>
                <span class="poster-title"><%= opera.titolo %></span>
                <span class="poster-director">UN FILM DI <%= opera.regista %></span>
              </span>
              <span class="poster-open" aria-hidden="true">↗</span>
            </a>
            <div class="film-card-info">
              <div>
                <h3><a href="/film/<%= opera.id %>"><%= opera.titolo %></a></h3>
                <p><%= opera.regista %></p>
              </div>
              <span class="film-year"><%= opera.anno %></span>
            </div>
          </article>
        <% }); %>
      </section>
    <% } %>
  </main>
</body>
</html>